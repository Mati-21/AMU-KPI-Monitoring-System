    {
      "name": "Quality audit rating",
      "description": "Rating given by the internal quality audit.",
      "theme": "OPS",
      "measurementType": "CATEGORY",
      "scale": "Quality Rating",
      "direction": "HIGHER_IS_BETTER",
      "frequency": "Annual",
      "dataSource": "Quality assurance office",
      "evidenceRequirement": "Signed audit report"
    },
    {
      "name": "Research income generated",
      "description": "Research income received in the period.",
      "theme": "RES",
      "measurementType": "MONEY",
      "currency": "ETB",
      "direction": "HIGHER_IS_BETTER",
      "frequency": "Quarterly",
      "dataSource": "Finance office statements",
      "evidenceRequirement": "Approved financial statement"
