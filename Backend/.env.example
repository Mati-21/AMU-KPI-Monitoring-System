# Server
PORT=8058
NODE_ENV=development
# Extra allowed CORS origins, comma separated (localhost dev ports are allowed by default)
CLIENT_URL=http://localhost:5174

# Database (DATABASE_URL is used by the Prisma CLI and the app; DB_* is the app fallback)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/kpi_monitoring_db?schema=public
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=kpi_monitoring_db

# JWT (required — the server refuses to start without JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-string
# Access token / session cookie lifetime (e.g. 15m, 1h, 1d)
JWT_EXPIRE=1h
# Refresh token cookie lifetime
JWT_REFRESH_EXPIRE=7d
# Max concurrent sessions per account; the least recently used are signed out beyond this
MAX_SESSIONS_PER_USER=10

# Logging: dev | tiny | off, and Prisma SQL logging
HTTP_LOG_MODE=dev
DB_LOG_SQL=false

# Super Admin seed (scripts/seedAdmin.js)
ADMIN_USERNAME=mati.admin
ADMIN_EMAIL=admin@amu.edu.et
ADMIN_FIRST_NAME=System
ADMIN_FATHER_NAME=Admin
ADMIN_GRANDFATHER_NAME=User
ADMIN_PHONE=0911000000
# Optional fixed temporary password; a random one is generated and printed when omitted
ADMIN_TEMP_PASSWORD=
