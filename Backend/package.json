{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "powershell -Command \"$ErrorActionPreference='SilentlyContinue'; $conn = Get-NetTCPConnection -LocalPort 8058; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force }; nodemon server.js\"",
    "dev:backend": "npm run dev",
    "seed": "node scripts/seedAdmin.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "db:seed": "node scripts/seedAdmin.js",
    "seed:kpis": "node scripts/seedKpis.js",
    "db:reset": "prisma db push --force-reset",
    "db:reset:seed": "prisma db push --force-reset && node scripts/seedAdmin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "KPI Monitoring System Backend API",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "otplib": "^13.5.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
